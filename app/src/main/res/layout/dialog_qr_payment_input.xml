<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/dialog_rounded_bg">

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/qr_dialog_jio_title"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center_horizontal"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvDialogPayee"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/netless_green"
        android:textSize="15sp"
        android:textStyle="bold"
        android:gravity="center_horizontal"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvDialogNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/qr_dialog_jio_explanation"
        android:textColor="@color/text_secondary_dark"
        android:textSize="13sp"
        android:lineSpacingExtra="2dp"
        android:gravity="center_horizontal"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:id="@+id/layoutPhoneInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/qr_dialog_phone_label"
            android:textColor="@color/text_secondary_dark"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etPhoneNumber"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/input_field_bg"
            android:hint="@string/qr_dialog_phone_hint"
            android:textColorHint="@color/text_secondary_dark"
            android:textColor="@color/white"
            android:inputType="number"
            android:maxLength="10"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutAmountInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/qr_dialog_amount_label"
            android:textColor="@color/text_secondary_dark"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etAmount"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/input_field_bg"
            android:hint="@string/qr_dialog_amount_hint"
            android:textColorHint="@color/text_secondary_dark"
            android:textColor="@color/white"
            android:inputType="numberDecimal"
            android:maxLength="6"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textSize="16sp" />

        <!-- Quick Amount Chips -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/chipAmount50"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/chip_quick_amount_bg"
                android:gravity="center"
                android:text="@string/qr_chip_50"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/chipAmount100"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/chip_quick_amount_bg"
                android:gravity="center"
                android:text="@string/qr_chip_100"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/chipAmount200"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/chip_quick_amount_bg"
                android:gravity="center"
                android:text="@string/qr_chip_200"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/chipAmount500"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/chip_quick_amount_bg"
                android:gravity="center"
                android:text="@string/qr_chip_500"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/chipAmount1000"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/chip_quick_amount_bg"
                android:gravity="center"
                android:text="@string/qr_chip_1000"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvDialogError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/error_red"
        android:textSize="13sp"
        android:gravity="center_horizontal"
        android:visibility="gone"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btnDialogCancel"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/qr_dialog_cancel_button"
            android:textColor="@color/text_secondary_dark"
            android:layout_marginEnd="12dp" />

        <Button
            android:id="@+id/btnDialogPay"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@string/qr_dialog_pay_button"
            android:textColor="@color/white"
            android:background="@drawable/button_rounded"
            android:paddingStart="20dp"
            android:paddingEnd="20dp" />

    </LinearLayout>

</LinearLayout>

